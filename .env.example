# Express / Vite runtime (repository root)
# Public browser-facing origin. Set to your real HTTPS domain in production.
APP_URL=
FRONTEND_ORIGIN=http://localhost:3000
# Laravel API upstream. Start Laravel separately on this address by default.
LARAVEL_API_URL=http://127.0.0.1:8100
# Leave empty to use same-origin /api through the Express reverse proxy.
VITE_API_URL=
# Optional: only starts a local Laravel artisan serve process when explicitly enabled.
# It never runs migrations, key generation, or storage:link automatically.
AUTO_START_LARAVEL=false
# Keep the Gemini key server-side; never put it in VITE_* variables.
GEMINI_API_KEY=
