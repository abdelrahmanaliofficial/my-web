{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run generate-sitemap && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/auth-rbac.test.ts tests/billing.test.ts tests/clients-lifecycle.test.ts tests/media-storage.test.ts tests/messaging.test.ts tests/project-files.test.ts tests/project-files-frontend.test.ts tests/project-tracking.test.ts",
    "start": "node dist/server.cjs",
    "test:laravel": "cd laravel && php artisan test",
    "test:laravel:unit": "cd laravel && php artisan test --testsuite=Unit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
